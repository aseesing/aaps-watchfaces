{
  "name": "aaps-watchface-designer",
  "version": "0.1.0",
  "description": "Design, check and build AAPS custom watch faces in the browser or from the command line.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "bin": {
    "cwf": "./src/cli/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "cwf": "node src/cli/cli.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.6.4",
    "upng-js": "^2.1.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
